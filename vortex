-- ==========================================
-- SISTEMA DE GHOSTING (ANTI-CHEAT BUSTER)
-- ==========================================
-- Este sistema tenta imitar ações "naturais" e esconder modificações
-- que anti-cheats comuns (como Byfron básico ou Anticheat nativo) detectam.
local GhostSystem = {
    Enabled = true,
    RandomizeMovement = true,
    HideModifications = false
}

function GhostSystem:Update()
    if not GhostSystem.Enabled then return end
    
    -- Simula leve flutuação na mira para parecer humano (Evita Aimbot linear)
    if Aimbot.Enabled and Aimbot.Lock then
        local offsetX = math.random(-2, 2) / 100
        local offsetY = math.random(-2, 2) / 100
        return Vector3.new(offsetX, offsetY, 0)
    end
    return Vector3.new()
end

