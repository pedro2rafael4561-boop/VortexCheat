LocalPlayer.CharacterAdded:Connect(function(Character)
    Character:WaitForChild("Humanoid")
    
    -- Speed Hack (Modifica o WalkSpeed do Humanoid)
    Character.Humanoid.WalkSpeed = Settings.Movement.Speed
    
    -- Jump Power
    Character.Humanoid.JumpPower = Settings.Movement.JumpPower
    
    -- No Fall Damage
    Character.Humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    
    -- Instant Hit / No Spread (Modifica a arma)
    -- Tenta encontrar a arma equipada ou na backpack
    local Tool = Character:FindFirstChild("Tool") or Character.Backpack:FindFirstChildOfClass("Tool")
    if Tool then
        local Handle = Tool:FindFirstChild("Handle")
        if Handle then
            -- Remover animação de recoil se possível
            -- Aumentar Range
            if Settings.GunExploits.InstantHit then
                Handle.Range.Value = 10000 -- Extremo
            end
        end
        
        -- No Recoil (Modifica as propriedades de recoil)
        if Settings.GunExploits.NoRecoil then
            local Properties = Tool:FindFirstChild("Properties")
            if Properties then
                -- Tenta desativar recoil visual e físico
                local RecoilProp = Properties:FindFirstChild("Recoil")
                if RecoilProp then RecoilProp.Value = 0 end
                local KickProp = Properties:FindFirstChild("Kick")
                if KickProp then KickProp.Value = 0 end
            end
        end
    end
end)

