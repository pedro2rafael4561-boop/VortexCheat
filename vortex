local function CreateSlider(Name, Min, Max, Callback)
    local Frame = CreateFrame("Slider_" .. Name, UDim2.new(0, 120, 0, 30), UDim2.new(0, 10, 0, 30), Color3.fromRGB(30, 30, 30))
    CreateLabel(Name, UDim2.new(0, 50, 0, 10), UDim2.new(0, 5, 0, 5), Frame, Color3.fromRGB(200,200,200), 12)
    
    local Slider = Instance.new("TextButton")
    Slider.Name = "Slider_" .. Name
    Slider.Size = UDim2.new(1, -10, 0, 10)
    Slider.Position = UDim2.new(0, 5, 0, 20)
    Slider.BackgroundColor3 = Color3.fromRGB(100,100,100)
    Slider.Text = ""
    Slider.Parent = Frame
    
    local Fill = Instance.new("Frame")
    Fill.Name = "Fill"
    Fill.Size = UDim2.new(0.5, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    Fill.Parent = Slider
    
    local dragging = false
    local startX, startWidth
    
    Slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            startX = input.Position.X
            startWidth = Fill.Size.X.Offset
        end
    end)
    
    Slider.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position.X - startX
            local newSize = math.clamp(startWidth + delta, 0, Slider.AbsoluteSize.X - 10)
            Fill.Size = UDim2.new(0, newSize, 1, 0)
            
            local percentage = newSize / (Slider.AbsoluteSize.X - 10)
            local value = math.floor(Min + percentage * (Max - Min))
            if Callback then Callback(value) end
        end
    end)
    
    Slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return Slider
end

