-- Helper: Obter o melhor ponto de impacto (Bone Lock)
function GetBonePart(Character, BoneName)
    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Root then return nil end
    
    local Bone = Character:FindFirstChild(BoneName)
    if Bone then return Bone end
    
    -- Fallback para cabeça se não encontrar
    if BoneName == "Head" then return Character:FindFirstChild("Head") end
    return nil
end

-- Helper: Calcular distância
function GetDistance(p1, p2)
    local v1 = p1.Position
    local v2 = p2.Position
    return (v1 - v2).Magnitude
end

-- Helper: Projectar ponto 3D para 2D
function WorldToScreen(Position)
    local Position, OnScreen = Camera:WorldToViewportPoint(Position)
    if OnScreen then
        return Vector2.new(Position.X, Position.Y), true
    end
    return nil, false
end

-- ==========================================
-- PREDATOR SIGHT (SISTEMA ÚNICO)
-- ==========================================
-- Cria uma silhueta visualmente distinta usando Highlight e Trail
local PredatorSightSystem = {
    Highlights = {},
    Trails = {}
}

function PredatorSightSystem:Update()
    if not Settings.PredatorSight.Enabled then
        for _, Highlight in pairs(PredatorSightSystem.Highlights) do
            Highlight:Destroy()
        end
        for _, Trail in pairs(PredatorSightSystem.Trails) do
            Trail:Destroy()
        end
        PredatorSightSystem.Highlights = {}
        PredatorSightSystem.Trails = {}
        return
    end
    
    local Target = AimbotState.Target
    
    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character and Player.Character.PrimaryPart then
            local Character = Player.Character
            local Humanoid = Character:FindFirstChild("Humanoid")
            
            if Humanoid and Humanoid.Health > 0 then
                -- Criar Highlight se não existir
                local H = Character:FindFirstChild("PredatorHighlight")
                if not H then
                    H = Instance.new("Highlight")
                    H.Name = "PredatorHighlight"
                    H.Adornee = Character
                    H.Parent = Character
                end
                
                -- Estilizar o Highlight base no estilo "Predator"
                H.FillTransparency = 0.8 -- Silhueta vazia
                H.FillColor = Settings.PredatorSight.HighlightColor
                H.OutlineTransparency = 0
                H.OutlineColor = Settings.PredatorSight.HighlightColor
                H.OutlineWidth = Settings.PredatorSight.OutlineWidth
                
                -- Adicionar Trail para rastrear movimento (Inovador)
                local T = Character:FindFirstChild("PredatorTrail")
                if not T then
                    T = Instance.new("Trail")
                    T.Name = "PredatorTrail"
                    T.Parent = Character.PrimaryPart
                end
                T.Enabled = true
                T.Color = ColorSequence.new(Settings.PredatorSight.HighlightColor)
                T.Lifetime = 0.1
                T.Attachment0 = Character.PrimaryPart.Attachment0 or Instance.new("Attachment", Character.PrimaryPart)
            end
        end
    end
end

-- ==========================================
-- AIMBOT ENGINE
-- ==========================================
RunService.RenderStepped:Connect(function()
    -- 1. Atualizar Ghosting
    local GhostOffset = GhostSystem:Update()
    
    -- 2. Lógica do Aimbot
    if Settings.Aimbot.Enabled then
        local TargetPart = nil
        local BestDist = math.huge
        
        -- Encontrar alvo mais próximo dentro do FOV
        for _, Player in pairs(Players:GetPlayers()) do
            if Player ~= LocalPlayer and Player.Character and Player.Character.PrimaryPart then
                local Bone = GetBonePart(Player.Character, Settings.Aimbot.Bone)
                if Bone then
                    local ScreenPos, OnScreen = WorldToScreen(Bone.Position)
                    if OnScreen then
                        local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        local Dist = (ScreenPos - Center).Magnitude
                        
                        if Dist < Settings.Aimbot.FOV and Dist < BestDist then
                            -- Verificar Line of Sight (Raycast simples)
                            local RayParams = RaycastParams.new()
                            RayParams.FilterDescendantsInstances = {LocalPlayer.Character}
                            RayParams.FilterType = Enum.RaycastFilterType.Exclude
                            local RaycastResult = workspace:Raycast(Camera.CFrame.Position, (Bone.Position - Camera.CFrame.Position) * 50, RayParams)
                            
                            if RaycastResult and RaycastResult.Instance.Parent == Player.Character then
                                BestDist = Dist
                                TargetPart = Bone
                                AimbotState.Target = Bone
                            end
                        end
                    end
                end
            end
        end
        
        -- Smooth Aim
        if TargetPart then
            local TargetCFrame = TargetPart.CFrame * GhostOffset
            local CurrentCFrame = Camera.CFrame
            local NewCFrame = CurrentCFrame:Lerp(CFrame.new(CurrentCFrame.Position, TargetCFrame.Position), Settings.Aimbot.Smoothness / 100)
            Camera.CFrame = NewCFrame
        else
            AimbotState.Target = nil
        end
    end
    
    -- 3. Lógica do Triggerbot
    if Settings.Triggerbot.Enabled then
        local CurrentTime = tick()
        if CurrentTime - TriggerbotState.LastFireTime > Settings.Triggerbot.Delay then
            -- Se o alvo está fixo na tela e dentro do FOV, "dispara" automaticamente
            if AimbotState.Target and (UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or true) then
                -- Simula disparo (em jogos reais, isso pode usar InputBegan ou apenas ser visual)
                -- Aqui, apenas indicamos que o trigger está "ativo"
                TriggerbotState.LastFireTime = CurrentTime
                -- O jogo real vai disparar se o jogador segurar o botão, ou podemos simular
                -- Para este script genérico, assumimos que o jogador segura o botão
            end
        end
    end
    
    -- 4. Atualizar Predator Sight
    PredatorSightSystem:Update()
    
    -- 5. Atualizar ESP (Box)
    -- (Simplificado: Em um script real, usaria um ScreenGui com Frames que seguem os pontos)
end)

